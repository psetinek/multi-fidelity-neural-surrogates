FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0;
        minIter	 10;
        maxIter	 300;
    }

    "(U|nuTilda|k|omega|e|rho)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0;
        minIter	 3;
        maxIter	 50;
    }
}

SIMPLE
{
    consistent		 yes;
    nNonOrthogonalCorrectors 3;

    residualControl
    {
        p               0;
        U               0;
        nuTilda         0;
        k               0;
        omega           0;
        h               0;
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
        rho             0.01;
    }
    equations
    {	
        h               0.7;
        U               0.7;
        nuTilda         0.7;
        k               0.7;
        omega           0.7;
    }
}


